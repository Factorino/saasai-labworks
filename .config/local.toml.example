# --- Local settings ----------------------------------------------------------
#
# Copy to .config/local.toml and edit the copy; that file is ignored by git.
# Every value can also be set through an environment variable, which takes
# precedence: APP__SERVER__PORT=8080, APP__KNOWLEDGE__QUESTION_LIMIT=6.
#
# Recipes: `just run`.

[service]
debug = false

[server]
host = "127.0.0.1"
port = 8000
reload = false

[api]
docs_enabled = true

[api.cors]
allow_origins = ["*"]

[knowledge]
ontology_path = "ontology/anamnesis.owl"
locales_dir = "locales"
# Pellet inferences running at once; each one is a separate Java process.
reasoner_concurrency = 2
# Clarifying questions per dialogue; the self-harm question may exceed it.
question_limit = 8

[llm]
# Any server speaking the OpenAI protocol: Ollama, vLLM, LM Studio. A server
# on the Windows host is reachable from WSL as localhost only in mirrored
# networking mode; in NAT mode use the default gateway address instead.
base_url = "http://localhost:11434/v1"
# Ollama and vLLM ignore the key, but the client requires one.
api_key = "unused"
model = "qwen3.5:9b"
temperature = 0.2
# Reply length limit; a reply cut off by it is treated as invalid.
max_tokens = 2048
# "none" turns off the thinking phase of reasoning models; remove the line to
# leave the server default.
reasoning_effort = "none"
# Seconds. The first request after idle also loads the model into memory.
connect_timeout = 5.0
request_timeout = 120.0
max_retries = 1
