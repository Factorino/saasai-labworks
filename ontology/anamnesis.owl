    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasDescription -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasDescription"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#affectsDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#affectsDomain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#cautionFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#cautionFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#firedRule -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#firedRule">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InferenceRule"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasManifestation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasManifestation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasStressor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasStressor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasUrgencyLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasUrgencyLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#indicatesCluster -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#indicatesCluster">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#recommendsPractice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#recommendsPractice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#suggestsPractice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#suggestsPractice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#durationWeeks -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#durationWeeks">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#frequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#frequency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#impactDegree -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#impactDegree">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#selfHarmScreening -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#selfHarmScreening">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AcademicPressure -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AcademicPressure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StudyStressor"/>
        <hasDescription>Pressure to get good grades or keep up with studies.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AccidentOrDisaster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AccidentOrDisaster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Going through a serious accident or disaster.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AcculturationStress -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AcculturationStress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContextStressor"/>
        <hasDescription>Difficulty adapting to a new culture or language.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActiveSelfHarmThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActiveSelfHarmThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmThoughts"/>
        <hasDescription>Thinking about actually harming oneself or ending one&apos;s life.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Exercises built around daily activity and routine.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Habits that are hard to control and cause problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AgingAndMidlife -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AgingAndMidlife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Adapting to getting older, midlife changes or children leaving home.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AngerOutbursts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AngerOutbursts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Sudden strong bursts of anger, such as shouting or breaking things.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietySign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Feeling tense, nervous or afraid that something bad may happen.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietyCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietyCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to worry, fear and avoidance.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietySign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietySign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AppetiteChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AppetiteChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Eating noticeably more or less than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Assault -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Assault">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Being physically attacked.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AssertiveCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AssertiveCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice"/>
        <hasDescription>Saying what one needs calmly and respectfully, using &quot;I&quot; statements.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Avoidance -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Avoidance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietySign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Staying away from situations, places or reminders that feel hard.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BedForSleepOnly -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BedForSleepOnly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepPractice"/>
        <hasDescription>Keeping the bed for sleep and getting up for a while if sleep does not come.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralActivation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralActivation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Gradually returning to pleasant and useful activities, one small step at a time.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in what a person does or avoids doing.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Bereavement -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Bereavement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossStressor"/>
        <hasDescription>The death of a close person.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MedicalCheckSign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Bodily reactions such as a pounding heart or shaking; a doctor can check their cause.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Exercises that calm the body.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyImageWorry -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyImageWorry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView"/>
        <hasDescription>Strong dissatisfaction with how one&apos;s body or appearance looks.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyPain -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyPain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>Aches in the back, neck or other parts of the body.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreakupOrDivorce -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreakupOrDivorce">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Separating from a partner or going through a divorce.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingDifficulty -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingDifficulty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns"/>
        <hasDescription>Feeling short of breath or unable to take a full breath, without severe distress.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice"/>
        <hasDescription>Slow, regular breathing that helps the body settle.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CareerUncertainty -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CareerUncertainty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Uncertainty about one&apos;s career path or future work.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CaregivingBurden -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CaregivingBurden">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor"/>
        <hasDescription>Looking after a relative who needs a lot of care.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InferenceRule"/>
        <hasDescription>One assessment of a person&apos;s request, built from the dialogue.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ChestPainOrSevereBreathing -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ChestPainOrSevereBreathing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns"/>
        <hasDescription>Chest pain or pressure, or serious trouble breathing.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ChildhoodAbuse -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ChildhoodAbuse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Having been abused or severely neglected as a child.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in thinking, attention, memory or sense of reality.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CommunityParticipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CommunityParticipation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LeisureAndCommunity"/>
        <hasDescription>Taking part in local, religious or other group activities.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveActions -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveActions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveSign"/>
        <hasDescription>Repeating actions such as checking or washing to feel less uneasy.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveSexualBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveSexualBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours"/>
        <hasDescription>Sexual urges or behaviour that feel hard to control and cause problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveShopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CompulsiveShopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours"/>
        <hasDescription>Shopping or spending that is hard to control.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConcentrationProblems -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConcentrationProblems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThinkingDifficulties"/>
        <hasDescription>Finding it hard to focus or to remember things.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InferenceRule"/>
        <hasDescription>The root of the linguistic layer: everything the dialogue can talk about.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A group of related experiences used to choose helpful practices; it is not a diagnosis.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>Managing ordinary everyday tasks.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DecisionDifficulty -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DecisionDifficulty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThinkingDifficulties"/>
        <hasDescription>Finding it hard to make even small decisions.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Depersonalization -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Depersonalization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dissociation"/>
        <hasDescription>Feeling as if one is watching oneself from outside.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DepressiveCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DepressiveCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to low mood and loss of interest.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Derealization -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Derealization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dissociation"/>
        <hasDescription>Feeling that the world around is unreal or strange.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DifficultySettingBoundaries -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DifficultySettingBoundaries">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalDifficulties"/>
        <hasDescription>Finding it hard to say no or to stand up for oneself.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DigestiveUpset -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DigestiveUpset">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns"/>
        <hasDescription>Nausea, stomach upset or other gut discomfort.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Disability -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Disability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor"/>
        <hasDescription>Living with a disability or a recent loss of physical ability.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisconnectionSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisconnectionSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DiscriminationOrExclusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DiscriminationOrExclusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Being treated unfairly or left out because of who one is.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisorderedEating -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisorderedEating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Strict food rules, binge eating, purging or constant worry about weight and shape.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dissociation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dissociation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisconnectionSign"/>
        <hasDescription>Feeling cut off from oneself or from what is going on around.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dizziness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Dizziness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns"/>
        <hasDescription>Feeling lightheaded or slightly unsteady, not sudden or severe.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EarRinging -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EarRinging">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>Hearing ringing, buzzing or other noise in the ears without an outside source.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalDisconnectionCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalDisconnectionCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to feeling numb or cut off.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in how a person feels emotionally.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalNumbness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalNumbness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DisconnectionSign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Feeling little or no emotion, as if feelings were switched off.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalOverwhelm -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalOverwhelm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Feeling that there is too much to cope with at once.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExamStress -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExamStress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StudyStressor"/>
        <hasDescription>Stress around exams or test periods.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveGaming -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveGaming">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours"/>
        <hasDescription>Video games or screen time taking over other parts of life.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveGuilt -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveGuilt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView"/>
        <hasDescription>Feeling guilty much more than the situation calls for.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveWorry -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ExcessiveWorry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety"/>
        <hasDescription>Worrying a lot about many things and finding it hard to stop.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FamilyConflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FamilyConflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Conflict with parents, children or other relatives.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FamilyRelationships -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FamilyRelationships">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships"/>
        <hasDescription>Relationships with family members.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Feeling tired or low in energy even after rest.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FearOfBeingTrapped -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FearOfBeingTrapped">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety"/>
        <hasDescription>Fear of places where it may be hard to leave or get help, such as crowds or transport.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FearOfRejection -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FearOfRejection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalDifficulties"/>
        <hasDescription>Strong fear of being rejected, criticised or left.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Finances -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Finances">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife"/>
        <hasDescription>Paying bills and managing money day to day.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialAndLegalStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialAndLegalStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain that comes from money, housing or legal problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialHardship -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialHardship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialAndLegalStressor"/>
        <hasDescription>Not having enough money for one&apos;s needs.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ForcedMigration -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ForcedMigration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Having to leave home because of danger or hardship.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FriendsAndSocialLife -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FriendsAndSocialLife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships"/>
        <hasDescription>Contact with friends and acquaintances.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Gambling -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Gambling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours"/>
        <hasDescription>Betting or gambling that is hard to stop.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GradualExposure -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GradualExposure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Facing feared situations step by step, starting with the easiest.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster"/>
        <hasDescription>Support needs after losing someone; grief itself is a natural response.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefSelfCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefSelfCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice"/>
        <hasDescription>Gentle care for oneself after a loss, with no rush to feel better.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GroundingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GroundingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice"/>
        <hasDescription>Using the senses to bring attention back to the present moment.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HarshSelfCriticism -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HarshSelfCriticism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView"/>
        <hasDescription>Judging oneself very harshly or demanding perfection.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Headache -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Headache">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>An ordinary headache or pressure in the head that did not start suddenly and severely.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain that comes from health problems, one&apos;s own or a loved one&apos;s.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthWorry -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthWorry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety"/>
        <hasDescription>Persistent worry about having or getting a serious illness.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HeartSensations -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HeartSensations">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns"/>
        <hasDescription>Noticing a strong or fast heartbeat, or feeling that blood pressure jumps.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hopelessness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hopelessness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood"/>
        <hasDescription>Feeling that the future holds nothing good or that nothing will change.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HouseholdTasks -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HouseholdTasks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife"/>
        <hasDescription>Keeping up with chores and running a home.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HousingInsecurity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HousingInsecurity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialAndLegalStressor"/>
        <hasDescription>Being at risk of losing one&apos;s home.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hypersomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hypersomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance"/>
        <hasDescription>Sleeping much more than usual and still feeling sleepy.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IdentityConfusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IdentityConfusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MeaningAndIdentity"/>
        <hasDescription>Being unsure who one is or what one values.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ImpulsiveOrRiskyBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ImpulsiveOrRiskyBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Acting on impulse in ways that may be risky, such as reckless driving or spending.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InferenceRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InferenceRule">
        <hasDescription>An SWRL rule of the knowledge base; its description explains a conclusion to the user.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Infertility -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Infertility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor"/>
        <hasDescription>Difficulty having a child.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Infidelity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Infidelity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>A partner&apos;s betrayal or affair.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance"/>
        <hasDescription>Difficulty falling asleep, staying asleep or waking up too early.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalDifficulties -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalDifficulties">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalSign"/>
        <hasDescription>Repeated difficulties in how one relates to other people.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <hasDescription>Unwanted thoughts or images that come to mind against a person&apos;s will.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Irritability -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Irritability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Getting annoyed or angry more easily than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Starting a new job or changing profession.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobInsecurity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobInsecurity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Fear of losing a job or having an unstable income from work.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobLoss -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#JobLoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Having lost a job or being out of work.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L0 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L0">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>Self-help practices and watching how things go may be enough for now.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>It is worth considering a consultation.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>It is recommended to see a specialist.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L3">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>It is necessary to get help urgently.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LackOfPurpose -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LackOfPurpose">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MeaningAndIdentity"/>
        <hasDescription>Feeling that life lacks meaning or direction.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LegalProblems -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LegalProblems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#FinancialAndLegalStressor"/>
        <hasDescription>Dealing with a court case, arrest or other legal trouble.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Leisure -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Leisure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LeisureAndCommunity"/>
        <hasDescription>Hobbies, rest and other enjoyable free-time activities.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LeisureAndCommunity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LeisureAndCommunity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>Free time and being part of a community.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeChangeCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeChangeCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster"/>
        <hasDescription>Support needs while adapting to a big change.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A part of life that a person&apos;s difficulties can affect.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>A group based on what is happening in a person&apos;s life.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>A big change in life that takes effort to adapt to, even when it is a positive one.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LimitNewsAndSocialMedia -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LimitNewsAndSocialMedia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Setting limits on news and social media, especially on comparing oneself with others.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Loneliness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Loneliness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Feeling alone or having too little contact with others.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LongingForDeceased -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LongingForDeceased">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GriefSign"/>
        <hasDescription>Strong longing for, or constant thoughts about, a person who has died.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossOfConsciousness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossOfConsciousness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns"/>
        <hasDescription>Fainting or passing out.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossOfInterest -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood"/>
        <hasDescription>Losing interest or pleasure in things that used to feel good.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Losing someone important.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
        <hasDescription>Feeling sad, empty or down for much of the time.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowSelfWorth -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowSelfWorth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView"/>
        <hasDescription>Feeling worthless or not good enough.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowWorkControl -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowWorkControl">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Having little say over one&apos;s work or an unclear role.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>Anything a person notices in their feelings, body, thoughts or behaviour.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Marriage -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Marriage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Getting married or starting to live together.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MeaningAndIdentity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MeaningAndIdentity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthSign"/>
        <hasDescription>Questions about who one is or what gives life meaning.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MedicalCheckSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MedicalCheckSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MemoryProblems -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MemoryProblems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MedicalCheckSign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThinkingDifficulties"/>
        <hasDescription>Forgetting things more than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MenstrualProblems -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MenstrualProblems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>Painful or irregular periods or other cycle problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Mindfulness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Mindfulness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Gently noticing the present moment, including breath and thoughts, without judging.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodDiary -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodDiary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Briefly noting mood and what happened during the day.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodSwings -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodSwings">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Mood changing sharply and quickly without a clear reason.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MuscleTension -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MuscleTension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Muscles feel tight or tense and are hard to relax.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthSign"/>
        <hasDescription>Seeing oneself in a harsh or negative way.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NewFamilyMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NewFamilyMember">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>A new child or another person joining the family.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Nightmares -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Nightmares">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance"/>
        <hasDescription>Frequent bad dreams that wake a person or leave them shaken.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NumbnessOrTingling -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NumbnessOrTingling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>Mild numbness or tingling that is not on one whole side of the body.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ObsessiveThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ObsessiveThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveSign"/>
        <hasDescription>The same distressing thought returning again and again.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OngoingDomesticViolence -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OngoingDomesticViolence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Being hurt, threatened or controlled at home now.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MedicalCheckSign"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Bodily complaints whose cause is unclear and that a doctor should check first.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OwnIllness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OwnIllness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor"/>
        <hasDescription>Living with one&apos;s own serious illness.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PanicEpisode -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PanicEpisode">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety"/>
        <hasDescription>A sudden wave of intense fear that passes after a while.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ParentalRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ParentalRole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships"/>
        <hasDescription>Caring for and raising one&apos;s children.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ParentingStress -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ParentingStress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Strain from raising children or difficulties with a child.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PartnerConflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PartnerConflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor"/>
        <hasDescription>Repeated arguments or tension with a partner.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PartnerRelationship -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PartnerRelationship">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships"/>
        <hasDescription>The relationship with a partner.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PassiveDeathThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PassiveDeathThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmThoughts"/>
        <hasDescription>Wishing not to exist or not to wake up, without any intention to act.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PetLoss -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PetLoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossStressor"/>
        <hasDescription>The death or loss of a pet.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PhysicalActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PhysicalActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Regular movement that suits a person, even a short walk.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PlanningAndBreaks -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PlanningAndBreaks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Breaking the day into manageable tasks and taking real breaks.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalProblemsCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalProblemsCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster"/>
        <hasDescription>Support needs linked to work, study, health, money or legal problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A safe, medicine-free exercise a person can try on their own.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PregnancyLoss -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PregnancyLoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LossStressor"/>
        <hasDescription>Losing a pregnancy.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PregnancyOrPostpartum -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PregnancyOrPostpartum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Pregnancy or the months after giving birth.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ProblemSolving -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ProblemSolving">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice"/>
        <hasDescription>Choosing one problem and working through possible steps.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Procrastination -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Procrastination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Putting off tasks even when it causes problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ProgressiveMuscleRelaxation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ProgressiveMuscleRelaxation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice"/>
        <hasDescription>Gently tensing and then releasing groups of muscles.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PsychoticSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PsychoticSign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>Hearing or seeing things others do not, or holding unusual beliefs that feel completely certain.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ReexperiencingEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ReexperiencingEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaSign"/>
        <hasDescription>Reliving a past frightening event as if it were happening now.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RegularRoutine -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RegularRoutine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Keeping fairly regular times for sleep, meals and daily activities.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipDifficultiesCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipDifficultiesCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeEventCluster"/>
        <hasDescription>Support needs linked to difficulties with other people.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelationshipStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain that comes from relationships with other people.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>How a person gets along with close people.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelativeIllness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelativeIllness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#HealthStressor"/>
        <hasDescription>A close person being seriously ill.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelaxingImagery -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RelaxingImagery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodyCalmingPractice"/>
        <hasDescription>Imagining a calm, safe place in detail to help the body relax.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relocation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Moving to a new home, city or country.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveThoughtsAndActionsCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RepetitiveThoughtsAndActionsCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to repeating thoughts and repeated actions.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Restlessness -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Restlessness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Finding it hard to sit still or keep calm in the body.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Retirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Retirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeTransition"/>
        <hasDescription>Leaving work at the end of a career.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Rumination -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Rumination">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
        <hasDescription>Going over past events or problems again and again without finding a way forward.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SchoolBullying -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SchoolBullying">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StudyStressor"/>
        <hasDescription>Being bullied or humiliated at school or university.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfCare -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfCare">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife"/>
        <hasDescription>The everyday ability to look after one&apos;s own hygiene, food and rest.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfCompassionPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfCompassionPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Treating oneself with the same kindness one would show a friend.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmBehaviour -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmBehaviour">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>Hurting oneself on purpose, such as cutting or burning.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfHarmThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <hasDescription>Thoughts about death or about harming oneself, when their nature is not yet clear.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfNeglect -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfNeglect">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
        <hasDescription>Stopping basic self-care such as washing, eating properly or keeping up with daily needs.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to how a person sees and values themselves.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SelfWorthSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SexualDifficulties -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SexualDifficulties">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#OtherBodilySymptoms"/>
        <hasDescription>Low sexual desire, pain or other difficulties with sex.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SexualViolence -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SexualViolence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Experiencing sexual assault or unwanted sexual acts.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Shame -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Shame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#NegativeSelfView"/>
        <hasDescription>Feeling deeply ashamed of oneself or wanting to hide.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Sleeping noticeably worse, less or more than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbanceCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbanceCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to sleep difficulties.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepPractice"/>
        <hasDescription>Everyday habits and conditions that make sleep easier.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Habits that can support better sleep.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SlowedMovement -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SlowedMovement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
        <hasDescription>Moving or speaking noticeably more slowly than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContact -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice"/>
        <hasDescription>Spending time or talking with someone one trusts.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContextStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContextStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain from the wider world or one&apos;s social environment.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialFear -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialFear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety"/>
        <hasDescription>Strong fear of being judged, embarrassed or rejected in social situations.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialMediaPressure -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialMediaPressure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContextStressor"/>
        <hasDescription>Pressure from social media, online comparison or harmful online content.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialWithdrawal -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialWithdrawal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMoodSign"/>
        <hasDescription>Pulling away from friends, family and other people.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation">
