    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>You mentioned a loss, so gentle self-care and support may help.</rdfs:comment>
        <rdfs:label>R19</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#c"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasStressor"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#c"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#s"/>
                            </rdf:Description>
                        </rdf:first>
