        <hasDescription>Intense fear of a particular thing or situation, such as heights or flying.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StrengthsList -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StrengthsList">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Writing down one&apos;s strengths, small successes and kind words from others.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences linked to strain and overload.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A situation or event in a person&apos;s life that puts them under strain.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StrokeLikeSigns -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StrokeLikeSigns">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns"/>
        <hasDescription>Sudden face droop, weakness on one side, speech or vision problems, or a sudden severe headache.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Study -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Study">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkAndStudy"/>
        <hasDescription>How well a person manages school or university.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StudyStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StudyStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain that comes from school or university.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SubstanceUse -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SubstanceUse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AddictiveBehaviours"/>
        <hasDescription>Using alcohol or drugs in a way that feels hard to control or causes problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SuddenHearingOrBalanceChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SuddenHearingOrBalanceChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns"/>
        <hasDescription>Suddenly losing hearing or having a strong spinning sensation.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Ways of getting support and handling life problems.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <hasDescription>A group based on what a person notices in themselves.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThinkingDifficulties -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThinkingDifficulties">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <hasDescription>Trouble with attention, memory or making decisions.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Exercises for working with thoughts and feelings.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtRecord -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtRecord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Writing down a thought and checking the evidence for and against it.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThreatVigilance -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThreatVigilance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaSign"/>
        <hasDescription>Constantly expecting danger and staying on guard.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TimeOut -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TimeOut">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SupportAndCopingPractice"/>
        <hasDescription>Stepping away from a heated situation until one calms down.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaReactionCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaReactionCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SymptomCluster"/>
        <hasDescription>Experiences that can follow a frightening event.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaSign"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>A frightening or dangerous event a person has lived through.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TremblingAndSweating -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TremblingAndSweating">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BodilyArousalSigns"/>
        <hasDescription>Shaking or sweating more than the situation would explain.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TrustDifficulties -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TrustDifficulties">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#InterpersonalDifficulties"/>
        <hasDescription>Finding it hard to trust or feel close to others.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UnusuallyHighEnergy -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UnusuallyHighEnergy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Having unusually high mood or energy, needing little sleep and acting on impulse.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>How soon it is advisable to contact a specialist.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentBodilyWarningSigns">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentMedicalMarker"/>
        <hasDescription>Bodily signs that need urgent medical help rather than self-care.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentMedicalMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgentMedicalMarker"/>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ValuesBasedAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ValuesBasedAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActivityPractice"/>
        <hasDescription>Choosing small actions that match what matters most to oneself.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ViolenceThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ViolenceThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>Thinking about or threatening to seriously hurt another person.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WarConflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WarConflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#TraumaticStressor"/>
        <hasDescription>Living through war or armed conflict.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Work -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Work">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkAndStudy"/>
        <hasDescription>How well a person manages their job.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkAndStudy -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkAndStudy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>How well a person manages work and studies.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkDisengagement -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkDisengagement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#StressMarker"/>
        <hasDescription>Feeling distant, cynical or ineffective about one&apos;s work.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkSchedule -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkSchedule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Shifts, night work, overtime or unpredictable hours.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PracticalStressor"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Stressor"/>
        <hasDescription>Strain that comes from a job or from losing one.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Workload -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Workload">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Too much work, a high pace or constant deadlines.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkplaceConflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkplaceConflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorkStressor"/>
        <hasDescription>Conflict, harassment or bullying at work.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorldEvents -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorldEvents">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialContextStressor"/>
        <hasDescription>Distress about news, political events or the state of the world.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorryTime -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#WorryTime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ThoughtPractice"/>
        <hasDescription>Setting aside a short daily time to write down worries instead of letting them fill the day.</hasDescription>
    </owl:Class>
    


