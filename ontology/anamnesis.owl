<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#"
     xml:base="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasDescription -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasDescription"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#affectsDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#affectsDomain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasManifestation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasManifestation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasUrgencyLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#hasUrgencyLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#indicatesCluster -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#indicatesCluster">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#recommendsPractice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#recommendsPractice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#suggestsPractice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#suggestsPractice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#durationWeeks -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#durationWeeks">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#frequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#frequency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#impactDegree -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#impactDegree">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#selfHarmScreening -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#selfHarmScreening">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActiveSelfHarmThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ActiveSelfHarmThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>Thoughts about harming oneself or ending one&apos;s life, especially with an intent or a plan.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Persistent worry, tension or fear that is hard to control.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietyCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AnxietyCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <hasDescription>Manifestations related to worry, fear and tension.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AppetiteChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AppetiteChange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Eating noticeably more or less than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>A sign that does not need emergency help but should be discussed with a specialist soon.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Avoidance -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Avoidance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Staying away from situations, places or tasks because they cause distress.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in what a person does and how they act.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BreathingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Slow, paced breathing exercises that help reduce tension.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Case">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>One assessment of a person&apos;s request, built from the dialogue.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in attention, memory and thinking.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConcentrationProblems -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConcentrationProblems">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <hasDescription>Difficulty focusing, making decisions or remembering things.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept">
        <hasDescription>The root of the linguistic layer: everything the dialogue can talk about.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A group of related manifestations used to choose helpful practices. It is not a diagnosis.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DailyLife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>Household chores, self-care and daily routine.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DepressiveCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#DepressiveCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <hasDescription>Manifestations related to low mood, loss of interest and low energy.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>Changes in feelings and mood.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Feeling tired or drained of energy even after rest.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GroundingPractice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#GroundingPractice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Techniques that bring attention back to the present moment through the senses.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hypersomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Hypersomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance"/>
        <hasDescription>Sleeping much more than usual and still not feeling rested.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Insomnia -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Insomnia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance"/>
        <hasDescription>Difficulty falling asleep, staying asleep or waking up too early.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#IntrusiveThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#CognitiveManifestation"/>
        <hasDescription>Unwanted thoughts that keep coming back and are hard to dismiss.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Irritability -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Irritability">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Getting annoyed or angry more easily than usual.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L0 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L0">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>You can try self-help practices and keep an eye on how you feel.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>It is worth considering a consultation with a specialist.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>It is recommended to see a specialist.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L3 -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#L3">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#UrgencyLevel"/>
        <hasDescription>You need urgent help right now.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>An area of everyday life that the difficulties may affect.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LowMood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#EmotionalManifestation"/>
        <hasDescription>Feeling sad, empty or hopeless most of the time and losing interest in things that used to bring joy.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A sign or complaint that a person notices in their feelings, body, thinking or behaviour.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodDiary -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#MoodDiary">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Writing down mood, events and thoughts every day to notice patterns.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PassiveDeathThoughts -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PassiveDeathThoughts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#AttentionMarker"/>
        <hasDescription>Thoughts that life is not worth living or a wish not to wake up, without any intent to act.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Concept"/>
        <hasDescription>A self-help technique without medication from the knowledge base.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PsychoticSign -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#PsychoticSign">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker"/>
        <hasDescription>Hearing or seeing things that others do not, or firm beliefs that others do not share.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Relationships">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#LifeDomain"/>
        <hasDescription>Family, partner and friends.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#RiskMarker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Manifestation"/>
        <hasDescription>A sign that may indicate a risk to life or safety and needs urgent help.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SomaticManifestation"/>
        <hasDescription>Changes in how well or how much a person sleeps.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbanceCluster -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepDisturbanceCluster">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#ConditionCluster"/>
        <hasDescription>Manifestations related to sleep.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepHygiene -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SleepHygiene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#Practice"/>
        <hasDescription>Habits and conditions that support healthy sleep.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialWithdrawal -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SocialWithdrawal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#BehaviouralManifestation"/>
        <hasDescription>Pulling away from friends, family and social contact.</hasDescription>
