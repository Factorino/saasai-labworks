        <hasDescription>Changes a person notices in their body, sleep or appetite.</hasDescription>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SpecificFear -->

    <owl:Class rdf:about="http://www.semanticweb.org/masen/ontologies/2026/10/anamnesis#SpecificFear">
